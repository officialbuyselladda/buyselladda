NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/buyselladda
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# GoDaddy Workspace Email (MX: secureserver.net)
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=support@buyselladda.com
EMAIL_PASS=your-mailbox-password
EMAIL_FROM=support@buyselladda.com
EMAIL_REPLY_TO=support@buyselladda.com

CLIENT_URL=https://dealkro.in
